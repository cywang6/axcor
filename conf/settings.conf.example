# Workflow Controller global auth settings
# Default location: ~/.config/workflow-controller/settings.conf
#
# For headless mode with custom settings dir, pass --settings-dir:
#   workflow-controller run --headless --settings-dir /path/to/my/configs
# ============================================================================

# Global defaults (used when a key doesn't specify its own model/base_url)
default_model: "claude-sonnet-4-6"
default_url: ""  # Leave empty for native Anthropic endpoint

# API keys — each key is a separate provider with optional per-key model and base_url.
# Rotated on rate-limit. Per-key values override global defaults.
api_keys:
  - key: "sk-ant-api03-your-key-here"
    # model and base_url omitted → uses global defaults
  - key: "sk-glm-your-key-here"
    model: "glm-5.2"
    base_url: "https://open.bigmodel.cn/api/anthropic"
